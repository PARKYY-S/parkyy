# ---- PARKYY settings (copy this to a file named ".env" and fill in) ----

# A shared secret so only your devices can talk to PARKYY's backend
PARKYY_AUTH_TOKEN=parkyy-local

# ---- Cloud brains (all OPTIONAL - PARKYY works free & offline without them) ----
# A subscription is NOT an API key. Get a pay-per-use API key from each console:
ANTHROPIC_API_KEY=          # Claude   - console.anthropic.com
OPENAI_API_KEY=             # GPT/Codex- platform.openai.com
GEMINI_API_KEY=             # Gemini   - aistudio.google.com  (has a FREE tier)
# FREE brains - just sign up, no card:
GROQ_API_KEY=               # Groq     - console.groq.com/keys   (fast Llama 3.3 70B)
OPENROUTER_API_KEY=         # OpenRouter - openrouter.ai/keys    (free ":free" models)

# Exact model names change over time - override the defaults here if needed:
# PARKYY_CLAUDE_MODEL=claude-sonnet-4-5
# PARKYY_GPT_MODEL=gpt-4o
# PARKYY_GEMINI_MODEL=gemini-2.5-flash
# PARKYY_GROQ_MODEL=llama-3.3-70b-versatile
# PARKYY_OPENROUTER_MODEL=openai/gpt-oss-120b:free

# ---- Local brain (LM Studio) ----
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL=hermes-2-pro-llama-3-8b

# ---- Voice (ElevenLabs key lives in voice.env, kept separate) ----

# ---- Optional image generation (or use free local Stable Diffusion) ----
# STABILITY_API_KEY=
# OPENAI_API_KEY is reused for images too

# ---- Optional: let PARKYY ask a big AI when it studies a topic (costs a little) ----
# PARKYY_ASK_AI=1
